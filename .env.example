WNX_WEB_BASE_URL=http://localhost:8080
WNX_SERVE_BASE_URL=http://localhost:8081
BACKEND_JAVA_BASE_URL=http://localhost:8088
AI_SERVICE_BASE_URL=http://localhost:8100
MCP_SERVER_BASE_URL=http://localhost:3202
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=smart_support
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
POSTGRES_DB=smart_support
POSTGRES_USER=smart_support
POSTGRES_PASSWORD=smart_support
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://smart_support:smart_support@localhost:5432/smart_support
PGVECTOR_ENABLED=true
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
LOG_QUERY_URL=http://localhost:3100
# Local MLX runtime (OpenAI-compatible server)
MLX_ENABLED=1
MLX_HOST=127.0.0.1
MLX_PORT=18090
MLX_MODEL=mlx-community/Qwen3.5-2B-4bit
MLX_MAX_TOKENS=512
# Ollama adapter is retained but disabled by default after MLX migration.
OLLAMA_ENABLED=0
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:1.5b
# LLM (OpenAI-compatible). Example: Aliyun Bailian (DashScope)
LLM_PROVIDER=bailian
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_WORKSPACE_ID=
LLM_MODEL=qwen3.6-flash
# Embedding model + dim. Local BGE-M3 MLX uses pgvector(1024).
EMBEDDING_MODEL=mlx-community/bge-m3-mlx-4bit
EMBEDDING_DIM=1024
EMBEDDING_VERSION=v1
APPROVAL_CALLBACK_URL=http://localhost:8088/api/approvals/callback